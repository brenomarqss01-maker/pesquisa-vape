{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "allowJs": true,
    "checkJs": false,
    "noEmit": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "resolveJsonModule": true,
    "skipLibCheck": true
  },
  "include": [
    "worker/**/*.js",
    "scripts/build-worker.mjs",
    "scripts/validate-worker.mjs"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "app",
    "build",
    "components",
    "db",
    "examples",
    "hooks",
    "lib",
    "vendor",
    "scripts/connector-preview"
  ]
}
